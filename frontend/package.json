{
  "name": "imaginghub",
  "private": true,
  "version": "0.10.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\"",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "vitest",
    "codegen": "graphql-codegen --config graphqlCodegen.ts"
  },
  "dependencies": {
    "@apollo/client": "^4.2.9",
    "@diamondlightsource/davidia": "1.0.3",
    "@diamondlightsource/sci-react-ui": "^0.6.2-alpha.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^9.0.0",
    "@mui/icons-material": "^7.3.11",
    "@mui/material": "^7.3.11",
    "@react-three/fiber": "^8.18.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axios": "^1.18.1",
    "fast-png": "^8.0.0",
    "graphql": "^16.14.2",
    "graphql-ws": "^6.1.0",
    "js-yaml": "^4.3.0",
    "keycloak-js": "^26.2.4",
    "ndarray": "^1.0.19",
    "react": "^18.3.1",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "rxjs": "^7.8.2",
    "tiff.js": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/near-operation-file-preset": "^5.2.1",
    "@graphql-codegen/typescript-operations": "^6.1.5",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/ndarray": "^1.0.14",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
